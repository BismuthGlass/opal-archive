{
  "manifest_version": 3,
  "name": "OpalArchive",
  "version": "0.5.0",
  "description": "Sends posts to OpalArchive to be downloaded, from a button on Reddit, Pinterest and 4chan or from the right-click menu.",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.reddit.com/*",
    "https://*.pinterest.com/*",
    "https://*.pinterest.co.uk/*",
    "https://*.pinterest.ca/*",
    "https://*.pinterest.com.au/*",
    "https://*.pinterest.de/*",
    "https://*.pinterest.fr/*",
    "https://*.pinterest.es/*",
    "https://*.pinterest.it/*",
    "https://*.pinterest.pt/*",
    "https://*.pinterest.ie/*",
    "https://*.pinterest.nz/*",
    "https://*.pinterest.at/*",
    "https://*.pinterest.ch/*",
    "https://*.pinterest.se/*",
    "https://*.pinterest.dk/*",
    "https://*.pinterest.jp/*",
    "https://*.pinterest.co.kr/*",
    "https://*.pinterest.com.mx/*",
    "https://*.pinterest.cl/*",
    "https://*.pinterest.ph/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Send this page to OpalArchive"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.reddit.com/*"
      ],
      "js": [
        "button.js",
        "sites/reddit.js"
      ],
      "css": [
        "button.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.pinterest.com/*",
        "https://*.pinterest.co.uk/*",
        "https://*.pinterest.ca/*",
        "https://*.pinterest.com.au/*",
        "https://*.pinterest.de/*",
        "https://*.pinterest.fr/*",
        "https://*.pinterest.es/*",
        "https://*.pinterest.it/*",
        "https://*.pinterest.pt/*",
        "https://*.pinterest.ie/*",
        "https://*.pinterest.nz/*",
        "https://*.pinterest.at/*",
        "https://*.pinterest.ch/*",
        "https://*.pinterest.se/*",
        "https://*.pinterest.dk/*",
        "https://*.pinterest.jp/*",
        "https://*.pinterest.co.kr/*",
        "https://*.pinterest.com.mx/*",
        "https://*.pinterest.cl/*",
        "https://*.pinterest.ph/*"
      ],
      "js": [
        "button.js",
        "sites/pinterest.js"
      ],
      "css": [
        "button.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://boards.4chan.org/*",
        "https://boards.4channel.org/*"
      ],
      "js": [
        "button.js",
        "sites/4chan.js"
      ],
      "css": [
        "button.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
