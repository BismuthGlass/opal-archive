{
  "manifest_version": 3,
  "name": "OpalArchive",
  "version": "0.1.0",
  "description": "Sends posts to OpalArchive to be downloaded: a button beside each Reddit post, and an entry in the right-click menu everywhere.",
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Send this page to OpalArchive" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "content_scripts": [
    {
      "matches": ["https://*.reddit.com/*"],
      "js": ["button.js", "sites/reddit.js"],
      "css": ["button.css"],
      "run_at": "document_idle"
    }
  ]
}
